<Border x:Class="MyButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FocusVisualStyle="{x:Null}" x:Name="PanBack"
             Focusable="True" UseLayoutRounding="False" SnapsToDevicePixels="False" Background="{DynamicResource ColorBrushSemiTransparent}">
    <Border CornerRadius="3" x:Name="PanFore" BorderThickness="1" BorderBrush="{DynamicResource ColorBrush1}" RenderTransformOrigin="0.5,0.5" Background="{DynamicResource ColorBrushHalfWhite}">
        <Border.RenderTransform>
            <ScaleTransform />
        </Border.RenderTransform>
        <!-- 文字色由 MyButton.RefreshColor 按填充/描边状态显式设置，不再复用边框色（深色强调色下会与背景融为一体） -->
        <TextBlock TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True" TextTrimming="None" HorizontalAlignment="Center" x:Name="LabText" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Foreground="{DynamicResource ColorBrush1}" FontSize="13" IsHitTestVisible="False">
            <TextBlock.RenderTransform>
                <ScaleTransform />
            </TextBlock.RenderTransform>
        </TextBlock>
    </Border>
</Border>